+#[cfg(test)]
+mod access_block_tests {
+    use super::*;
+    #[test]
+    fn blocks_override_open_and_approved_allow_lists() {
+        for mode in ["open", "approved"] {
+            let mut s = Snapshot::default();
+            s.mode = mode.into();
+            s.allow.insert("123456".into());
+            s.blocked.insert("123456".into());
+            assert!(!s.may_initiate("123456"));
+        }
+    }
+    #[test]
+    fn ip_expiry_is_absolute_and_normalizes_mapped_addresses() {
+        let mut s = Snapshot::default();
+        s.blocked_ips.insert("192.0.2.1".into(), 100);
+        assert!(s.ip_blocked_at("192.0.2.1".parse().unwrap(), 99));
+        assert!(s.ip_blocked_at("::ffff:192.0.2.1".parse().unwrap(), 99));
+        assert!(!s.ip_blocked_at("192.0.2.1".parse().unwrap(), 100));
+        assert!(!s.ip_blocked_at("192.0.2.2".parse().unwrap(), 99));
+        s.blocked_ips.insert("2001:db8::1".into(), 100);
+        assert!(s.ip_blocked_at("2001:db8:0:0::1".parse().unwrap(), 99));
+    }
+    #[test]
+    fn old_snapshots_keep_existing_behavior() {
+        let s: Snapshot = serde_json::from_str(r#"{"mode":"open"}"#).unwrap();
+        assert!(s.may_initiate("123456"));
+        assert!(s.blocked.is_empty());
+        assert!(s.blocked_ips.is_empty());
+    }
+}
